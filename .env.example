# CreatorBridge frontend environment variables
# Copy names only. Never commit real secrets.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# Optional frontend integrations
VITE_TURNSTILE_SITE_KEY=
VITE_GOOGLE_CLIENT_ID=

# QA test account credentials (used by scripts/verify-*.mjs and browser walkthroughs
# only — never expose in frontend). Set these in your local .env file. Never commit
# the actual values. These CREATORBRIDGE_QA_* names are the ones the verify scripts read.
CREATORBRIDGE_QA_CREATOR_EMAIL=drl33+creator@creatorbridge.studio
CREATORBRIDGE_QA_CREATOR_PASSWORD=
CREATORBRIDGE_QA_CLIENT_EMAIL=drl33+client@creatorbridge.studio
CREATORBRIDGE_QA_CLIENT_PASSWORD=
CREATORBRIDGE_QA_ADMIN_EMAIL=drl33@creatorbridge.studio

# Public URL for the authentic logo embedded by the contract PDF function.
# Set this as a Supabase function secret before deploying contract functions.
CONTRACT_LOGO_URL=https://www.creatorbridge.studio/images/brand/creatorbridge-platform-logo-transparent.png
CREATORBRIDGE_QA_ADMIN_PASSWORD=

# Backend-only keys (set in Vercel environment variables and Supabase edge function secrets)
# SUPABASE_SERVICE_ROLE_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# ZOOM_VIDEO_SDK_KEY=        # SDK credentials: sign session join tokens
# ZOOM_VIDEO_SDK_SECRET=
# ZOOM_VIDEO_API_KEY=        # API credentials: recording lookup/deletion
# ZOOM_VIDEO_API_SECRET=
# ZOOM_WEBHOOK_SECRET=       # Event subscription Secret Token
# Do not add secret API keys with VITE_ prefixes.
# Anthropic/OpenAI, Twilio, Stripe secret, Stripe webhook, and Supabase service role keys belong in backend/Supabase secrets only.
